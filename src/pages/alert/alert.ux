<template>
  <scroll class="page" scroll-y="true">
    <div class="content">
      <text class="eyebrow">SAFETY CHECK</text>
      <text class="title">{{ typeLabel }}</text>
      <text class="subtitle">请确认你现在是否安全</text>

      <div class="countdown-ring">
        <text class="countdown">{{ countdown }}</text>
        <text class="countdown-unit">秒后自动求助</text>
      </div>

      <input class="safe-button" type="button" value="我没事，取消告警" onclick="confirmSafe" />
      <input class="help-button" type="button" value="立即求助" onclick="requestHelp" />
      <text class="hint">无操作时自动发送或进入离线队列</text>

      <div class="evidence-card">
        <div class="evidence-head">
          <text class="evidence-title">端侧判断依据</text>
          <text class="confidence">{{ confidence }}%</text>
        </div>
        <div class="reason" for="{{ reasons }}">
          <div class="reason-dot"></div>
          <text class="reason-text">{{ $item }}</text>
        </div>
        <div class="evidence-footer">
          <text class="evidence-small">峰值 {{ peakG }}g</text>
          <text class="evidence-small">{{ locationLabel }}</text>
        </div>
      </div>

      <div class="message-card">
        <div class="message-head">
          <text class="message-title">求助消息预览</text>
          <text class="message-badge">结构化</text>
        </div>
        <text class="message-name">{{ messageTitle }}</text>
        <text class="message-line">类型：{{ typeLabel }}</text>
        <text class="message-line">时间：{{ messageTime }}</text>
        <text class="message-line">位置：{{ locationLabel }}</text>
        <text class="message-line">置信度：{{ confidence }}%</text>
        <text class="message-line">佩戴者：{{ wearerStatus }}</text>
        <text class="message-line">设备状态：{{ deviceStatus }}</text>
        <text class="message-line">通知对象：{{ recipientSummary }}</text>
      </div>

    </div>
  </scroll>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
import {buildEmergencyMessage, resolveAlert} from "../../common/event-machine.js"
import {addEvent, loadContacts, loadSettings} from "../../common/storage.js"

export default {
  private: {
    typeLabel: "安全确认",
    confidence: 100,
    reasons: [],
    peakG: "--",
    locationLabel: "位置待确认",
    countdown: 10,
    messageTitle: "VelaGuard安全提醒",
    messageTime: "--",
    wearerStatus: "佩戴者10秒内未响应",
    deviceStatus: "检查网络状态中",
    recipientSummary: "读取联系人中"
  },

  onInit() {
    this.timer = null
    this.handled = false
  },

  onShow() {
    const alert = this.$app.$def.getCurrentAlert()
    if (!alert) {
      router.back()
      return
    }

    this.alert = alert
    this.typeLabel = alert.typeLabel
    this.confidence = alert.confidence
    this.reasons = alert.reasons
    this.peakG = alert.peakG
    this.locationLabel = alert.locationLabel
    this.countdown = alert.type === "sos" ? 6 : 10
    this.messageTime = alert.timeLabel
    this.loadPreview()
    this.startCountdown()
    this.vibrate()
  },

  loadPreview() {
    const page = this
    loadSettings(function(settings) {
      page.settings = settings
      loadContacts(function(contacts) {
        page.contacts = contacts
        const message = buildEmergencyMessage(page.alert, "timeout", settings.demoOffline, contacts)
        page.messageTitle = message.title
        page.wearerStatus = message.wearerStatus
        page.deviceStatus = message.deviceStatus
        page.recipientSummary = message.recipients
      })
    })
  },

  onHide() {
    this.stopCountdown()
  },

  onDestroy() {
    this.stopCountdown()
  },

  vibrate() {
    try {
      vibrator.vibrate({
        mode: "long"
      })
    } catch (error) {
      console.log("vibrator unavailable", error)
    }
  },

  startCountdown() {
    const page = this
    this.stopCountdown()
    this.timer = setInterval(function() {
      page.countdown -= 1
      if (page.countdown <= 0) {
        page.resolve("timeout")
      }
    }, 1000)
  },

  stopCountdown() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  confirmSafe() {
    this.resolve("safe")
  },

  requestHelp() {
    this.resolve("help")
  },

  resolve(action) {
    const page = this
    if (this.handled || !this.alert) {
      return
    }

    this.handled = true
    this.stopCountdown()
    loadSettings(function(settings) {
      loadContacts(function(contacts) {
        const resolved = resolveAlert(page.alert, action, settings.demoOffline, contacts)
        addEvent(resolved, function() {
          page.$app.$def.clearCurrentAlert()
          page.$app.$def.setCurrentEvent(resolved)
          router.push({
            uri: "/pages/event-detail"
          })
        })
      })
    })
  }
}
</script>

