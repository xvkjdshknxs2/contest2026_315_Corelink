<template>
  <stack class="page">
    <swiper
      class="swiper"
      indicator="false"
      loop="false"
      duration="250"
      onchange="onSwiperChange"
    >
      <!-- 第 1 页：天气 -->
      <div class="slide">
        <div class="slide-head">
          <input class="back-button" type="button" value="‹" onclick="goBack" />
          <text class="slide-title">天气</text>
          <div class="head-spacer"></div>
        </div>

        <div class="weather-body">
          <div class="weather-city-row">
            <text class="weather-city">{{ wCity }}</text>
            <text class="cache-badge" if="{{ wCached }}">已缓存</text>
          </div>
          <text class="weather-icon">{{ wIcon }}</text>
          <text class="weather-temp">{{ wTemp }}°</text>
          <text class="weather-condition">{{ wCondition }}</text>
          <text class="weather-feels">体感 {{ wFeels }}°</text>

          <div class="hourly-row">
            <div class="hourly-card" for="{{ wHourly }}">
              <text class="hourly-time">{{ $item.time }}</text>
              <text class="hourly-icon">{{ $item.icon }}</text>
              <text class="hourly-temp">{{ $item.temp }}°</text>
            </div>
          </div>
        </div>
      </div>

      <!-- 第 2 页：心率 -->
      <div class="slide">
        <div class="slide-head">
          <input class="back-button" type="button" value="‹" onclick="goBack" />
          <text class="slide-title">心率</text>
          <div class="head-spacer"></div>
        </div>

        <div class="heart-body">
          <div class="heart-ring {{ bpmStatusClass }}">
            <text class="heart-bpm">{{ bpm }}</text>
            <text class="heart-unit">BPM</text>
            <text class="heart-state {{ bpmStateClass }}">{{ bpmStateText }}</text>
          </div>

          <div class="heart-stats">
            <div class="heart-stat">
              <text class="heart-stat-value">{{ bpmMax }}</text>
              <text class="heart-stat-label">今日最高</text>
            </div>
            <div class="heart-stat">
              <text class="heart-stat-value">{{ bpmMin }}</text>
              <text class="heart-stat-label">今日最低</text>
            </div>
          </div>

          <text class="heart-warning" if="{{ bpmStatus !== 'normal' }}">心率异常，请注意休息</text>

          <div class="sos-button {{ sosPressed ? 'sos-pressed' : '' }}" ontouchstart="sosTouchStart" ontouchend="sosTouchEnd" ontouchcancel="sosTouchEnd">
            <text class="sos-text">{{ sosLabel }}</text>
          </div>
        </div>
      </div>

      <!-- 第 3 页：步数 -->
      <div class="slide">
        <div class="slide-head">
          <input class="back-button" type="button" value="‹" onclick="goBack" />
          <text class="slide-title">步数</text>
          <div class="head-spacer"></div>
        </div>

        <div class="steps-body" if="{{ !showChart }}">
          <text class="steps-value">{{ steps }}</text>
          <text class="steps-unit">今日步数</text>

          <div class="steps-stats">
            <div class="steps-stat">
              <text class="steps-stat-value">{{ distanceKm }}</text>
              <text class="steps-stat-label">公里</text>
            </div>
            <div class="steps-stat">
              <text class="steps-stat-value">{{ calories }}</text>
              <text class="steps-stat-label">千卡</text>
            </div>
          </div>

          <input class="chart-button" type="button" value="查看 7 天历史" onclick="toggleChart" />
        </div>

        <div class="steps-body" if="{{ showChart }}">
          <text class="chart-title">近 7 天步数</text>
          <div class="chart">
            <div class="chart-col" for="{{ stepHistory }}">
              <text class="chart-value">{{ $item.steps }}</text>
              <div class="chart-bar-wrap">
                <div class="chart-bar {{ $item.levelClass }}"></div>
              </div>
              <text class="chart-label">{{ $item.label }}</text>
            </div>
          </div>
          <input class="chart-button" type="button" value="返回今日" onclick="toggleChart" />
        </div>
      </div>

      <!-- 第 4 页：久坐提醒 -->
      <div class="slide">
        <div class="slide-head">
          <input class="back-button" type="button" value="‹" onclick="goBack" />
          <text class="slide-title">久坐提醒</text>
          <div class="head-spacer"></div>
        </div>

        <div class="sed-body">
          <div class="sed-toggle-row">
            <div class="sed-toggle-copy">
              <text class="sed-toggle-title">久坐提醒</text>
              <text class="sed-toggle-note">基于 IMU 检测连续静坐</text>
            </div>
            <switch class="sed-switch" checked="{{ sedEnabled }}" onchange="onSedToggle"></switch>
          </div>

          <div class="sed-timer-card">
            <text class="sed-timer-value">{{ sedMinutes }}</text>
            <text class="sed-timer-unit">分钟</text>
            <text class="sed-timer-seconds">已静坐 {{ sedTimeText }}</text>
          </div>

          <div class="sed-threshold">
            <text class="sed-threshold-label">提醒阈值：{{ sedThreshold }} 分钟（30 - 120）</text>
            <div class="sed-controls">
              <input class="sed-adjust" type="button" value="− 5" onclick="decThreshold" />
              <input class="sed-adjust" type="button" value="+ 5" onclick="incThreshold" />
            </div>
          </div>

          <text class="sed-hint">超时后振动提醒并自动重置计时</text>
        </div>
      </div>

      <!-- 第 5 页：闹钟 -->
      <div class="slide">
        <div class="slide-head">
          <input class="back-button" type="button" value="‹" onclick="goBack" />
          <text class="slide-title">闹钟</text>
          <div class="head-spacer"></div>
        </div>

        <div class="alarm-body">
          <scroll class="alarm-list" scroll-y="true" if="{{ !showAlarmForm }}">
            <div class="alarm-empty" if="{{ alarms.length === 0 }}">
              <text class="alarm-empty-text">暂无闹钟</text>
              <text class="alarm-empty-note">点击下方按钮添加</text>
            </div>
            <div class="alarm-item" for="{{ alarms }}" tid="id">
              <div class="alarm-item-copy">
                <text class="alarm-time">{{ $item.timeText }}</text>
                <text class="alarm-repeat">{{ $item.repeatText }}</text>
              </div>
              <switch class="alarm-switch" checked="{{ $item.enabled }}" onchange="onAlarmToggle($item.id)"></switch>
              <input class="alarm-delete" type="button" value="✕" onclick="removeAlarm($item.id)" />
            </div>
          </scroll>

          <div class="alarm-form" if="{{ showAlarmForm }}">
            <text class="form-title">添加闹钟</text>
            <div class="time-picker">
              <div class="time-col">
                <input class="form-adjust" type="button" value="▲" onclick="incAlarmHour" />
                <text class="time-value">{{ newAlarmHourText }}</text>
                <input class="form-adjust" type="button" value="▼" onclick="decAlarmHour" />
              </div>
              <text class="time-colon">:</text>
              <div class="time-col">
                <input class="form-adjust" type="button" value="▲" onclick="incAlarmMinute" />
                <text class="time-value">{{ newAlarmMinuteText }}</text>
                <input class="form-adjust" type="button" value="▼" onclick="decAlarmMinute" />
              </div>
            </div>

            <div class="repeat-picker">
              <input
                class="repeat-option {{ newAlarmRepeat === 'once' ? 'repeat-active' : '' }}"
                type="button"
                value="单次"
                onclick="setAlarmRepeat('once')"
              />
              <input
                class="repeat-option {{ newAlarmRepeat === 'daily' ? 'repeat-active' : '' }}"
                type="button"
                value="每天"
                onclick="setAlarmRepeat('daily')"
              />
              <input
                class="repeat-option {{ newAlarmRepeat === 'weekday' ? 'repeat-active' : '' }}"
                type="button"
                value="工作日"
                onclick="setAlarmRepeat('weekday')"
              />
            </div>

            <div class="form-actions">
              <input class="form-cancel" type="button" value="取消" onclick="cancelAlarmForm" />
              <input class="form-save" type="button" value="保存" onclick="saveAlarm" />
            </div>
          </div>

          <input
            class="alarm-add"
            if="{{ !showAlarmForm }}"
            type="button"
            value="+ 添加闹钟（{{ alarms.length }}/10）"
            onclick="openAlarmForm"
          />
        </div>
      </div>
    </swiper>

    <!-- 底部圆点指示器 -->
    <div class="dots">
      <div class="dot {{ dotClass0 }}"></div>
      <div class="dot {{ dotClass1 }}"></div>
      <div class="dot {{ dotClass2 }}"></div>
      <div class="dot {{ dotClass3 }}"></div>
      <div class="dot {{ dotClass4 }}"></div>
    </div>

    <!-- 顶部提示条 -->
    <div class="toast" if="{{ toast !== '' }}">
      <text class="toast-text">{{ toast }}</text>
    </div>

    <!-- 闹钟全屏响铃 -->
    <div class="alarm-overlay" if="{{ activeAlarm }}">
      <text class="overlay-eyebrow">闹钟响铃</text>
      <text class="overlay-time">{{ alarmTimeText }}</text>
      <text class="overlay-label">{{ alarmLabel }}</text>
      <div class="overlay-actions">
        <input class="overlay-button snooze" type="button" value="贪睡 5 分钟" onclick="snooze" />
        <input class="overlay-button dismiss" type="button" value="关闭" onclick="dismiss" />
      </div>
    </div>
  </stack>
</template>

<script>
import router from "@system.router"
import {createSosAlert} from "../../common/event-machine.js"
import {getWeather} from "../../common/weather-service.js"
import {
  start,
  stop,
  subscribe,
  setSedentaryEnabled,
  setSedentaryThreshold,
  addAlarm,
  removeAlarm,
  setAlarmEnabled,
  dismissAlarm,
  snoozeAlarm,
  repeatLabel
} from "../../common/health-store.js"

function pad(value) {
  return value < 10 ? "0" + value : String(value)
}

export default {
  private: {
    currentIndex: 0,
    dotClass0: "dot-on",
    dotClass1: "",
    dotClass2: "",
    dotClass3: "",
    dotClass4: "",
    // 天气
    wCity: "校园东区",
    wTemp: "--",
    wFeels: "--",
    wCondition: "--",
    wIcon: "☀",
    wCached: false,
    wHourly: [],
    // 心率
    bpm: "--",
    bpmMin: "--",
    bpmMax: "--",
    bpmStatus: "normal",
    bpmStatusClass: "ring-normal",
    bpmStateText: "静息",
    bpmStateClass: "",
    sosLabel: "长按 3 秒触发 SOS",
    sosPressed: false,
    // 步数
    steps: 0,
    distanceKm: "0.00",
    calories: 0,
    showChart: false,
    stepHistory: [],
    // 久坐
    sedSeconds: 0,
    sedMinutes: 0,
    sedEnabled: true,
    sedThreshold: 60,
    sedTimeText: "00:00",
    // 闹钟
    alarms: [],
    showAlarmForm: false,
    newAlarmHour: 7,
    newAlarmMinute: 0,
    newAlarmHourText: "07",
    newAlarmMinuteText: "00",
    newAlarmRepeat: "once",
    activeAlarm: null,
    alarmTimeText: "",
    alarmLabel: "",
    // 提示
    toast: ""
  },

  onInit() {
    this.unsubs = []
    this.sosTimer = null
    this.sosCount = 3
    this.toastTimer = null
  },

  onShow() {
    this.healthStoreStart()
    this.loadWeather()
  },

  onHide() {
    this.clearSubscriptions()
    this.clearSosTimer()
    stop()
  },

  onDestroy() {
    this.clearSubscriptions()
    this.clearSosTimer()
    stop()
  },

  healthStoreStart() {
    const page = this
    start()

    this.unsubs.push(
      subscribe("heart", function(data) {
        page.bpm = data.bpm
        page.bpmMin = data.min
        page.bpmMax = data.max
        page.bpmStatus = data.status
        page.refreshHeartLabel()
      })
    )

    this.unsubs.push(
      subscribe("steps", function(data) {
        page.steps = data.steps
        page.distanceKm = data.distanceKm
        page.calories = data.calories
        page.decorateHistory(data.history)
      })
    )

    this.unsubs.push(
      subscribe("sedentary", function(data) {
        page.sedSeconds = data.seconds
        page.sedMinutes = data.minutes
        page.sedEnabled = data.enabled
        page.sedThreshold = data.threshold
        page.sedTimeText = pad(data.minutes) + ":" + pad(data.seconds % 60)
      })
    )

    this.unsubs.push(
      subscribe("alarms", function(list) {
        page.decorateAlarms(list)
      })
    )

    this.unsubs.push(
      subscribe("alarm", function(alarm) {
        page.activeAlarm = alarm
        if (alarm) {
          page.alarmTimeText = pad(alarm.hour) + ":" + pad(alarm.minute)
          page.alarmLabel = alarm.label || "闹钟"
        }
      })
    )

    this.unsubs.push(
      subscribe("warning", function(warning) {
        page.onWarning(warning)
      })
    )
  },

  clearSubscriptions() {
    for (let index = 0; index < this.unsubs.length; index += 1) {
      if (typeof this.unsubs[index] === "function") {
        this.unsubs[index]()
      }
    }
    this.unsubs = []
  },

  loadWeather() {
    const page = this
    getWeather(function(weather) {
      page.wCity = weather.city
      page.wTemp = weather.temperature
      page.wFeels = weather.feelsLike
      page.wCondition = weather.condition
      page.wIcon = weather.icon
      page.wCached = Boolean(weather.cached)
      page.wHourly = weather.hourly || []
    })
  },

  refreshHeartLabel() {
    if (this.bpmStatus === "high") {
      this.bpmStatusClass = "ring-warning"
      this.bpmStateText = "心率过高"
      this.bpmStateClass = "state-warning"
    } else if (this.bpmStatus === "low") {
      this.bpmStatusClass = "ring-warning"
      this.bpmStateText = "心率过低"
      this.bpmStateClass = "state-warning"
    } else {
      this.bpmStatusClass = "ring-normal"
      this.bpmStateText = "静息正常"
      this.bpmStateClass = ""
    }
  },

  onWarning(warning) {
    if (warning.type === "heart") {
      this.toast = "异常心率预警 " + warning.bpm + " BPM"
    } else if (warning.type === "sedentary") {
      this.toast = "已静坐超 " + warning.threshold + " 分钟，请起身活动"
    }
    const page = this
    if (this.toastTimer) {
      clearTimeout(this.toastTimer)
    }
    this.toastTimer = setTimeout(function() {
      page.toast = ""
    }, 4000)
  },

  decorateAlarms(list) {
    const result = []
    for (let index = 0; index < list.length; index += 1) {
      const alarm = list[index]
      result.push({
        id: alarm.id,
        hour: alarm.hour,
        minute: alarm.minute,
        repeat: alarm.repeat,
        enabled: alarm.enabled,
        label: alarm.label,
        timeText: pad(alarm.hour) + ":" + pad(alarm.minute),
        repeatText: repeatLabel(alarm.repeat)
      })
    }
    this.alarms = result
  },

  decorateHistory(history) {
    let max = 1
    for (let index = 0; index < history.length; index += 1) {
      if (history[index].steps > max) {
        max = history[index].steps
      }
    }
    const result = []
    for (let index = 0; index < history.length; index += 1) {
      const level = Math.max(1, Math.round((history[index].steps / max) * 10))
      result.push({
        label: history[index].label,
        steps: history[index].steps,
        levelClass: "bar-h" + level
      })
    }
    this.stepHistory = result
  },

  onSwiperChange(event) {
    let index = 0
    if (event && event.index !== undefined) {
      index = event.index
    } else if (event && event.detail && event.detail.index !== undefined) {
      index = event.detail.index
    }
    this.currentIndex = index
    this.refreshDots()
  },

  refreshDots() {
    this.dotClass0 = this.currentIndex === 0 ? "dot-on" : ""
    this.dotClass1 = this.currentIndex === 1 ? "dot-on" : ""
    this.dotClass2 = this.currentIndex === 2 ? "dot-on" : ""
    this.dotClass3 = this.currentIndex === 3 ? "dot-on" : ""
    this.dotClass4 = this.currentIndex === 4 ? "dot-on" : ""
  },

  // 心率页 SOS（长按 3 秒）
  sosTouchStart() {
    const page = this
    this.sosPressed = true
    this.sosCount = 3
    this.sosLabel = "松开取消 · " + this.sosCount + " 秒后求助"
    this.sosTimer = setInterval(function() {
      page.sosCount -= 1
      if (page.sosCount <= 0) {
        page.clearSosTimer()
        page.sosPressed = false
        page.sosLabel = "长按 3 秒触发 SOS"
        page.fireSos()
        return
      }
      page.sosLabel = "松开取消 · " + page.sosCount + " 秒后求助"
    }, 1000)
  },

  sosTouchEnd() {
    this.clearSosTimer()
    this.sosPressed = false
    this.sosLabel = "长按 3 秒触发 SOS"
  },

  clearSosTimer() {
    if (this.sosTimer) {
      clearInterval(this.sosTimer)
      this.sosTimer = null
    }
  },

  fireSos() {
    this.$app.$def.setCurrentAlert(createSosAlert())
    router.push({
      uri: "/pages/alert"
    })
  },

  // 步数页
  toggleChart() {
    this.showChart = !this.showChart
  },

  // 久坐页
  onSedToggle(event) {
    const checked = event && event.checked !== undefined ? event.checked : !this.sedEnabled
    this.sedEnabled = checked
    setSedentaryEnabled(checked)
  },

  incThreshold() {
    const next = Math.min(120, this.sedThreshold + 5)
    this.sedThreshold = next
    setSedentaryThreshold(next)
  },

  decThreshold() {
    const next = Math.max(30, this.sedThreshold - 5)
    this.sedThreshold = next
    setSedentaryThreshold(next)
  },

  // 闹钟页
  openAlarmForm() {
    const now = new Date()
    let minute = now.getMinutes() + 1
    let hour = now.getHours()
    if (minute >= 60) {
      minute = minute - 60
      hour = hour + 1
      if (hour >= 24) {
        hour = 0
      }
    }
    this.newAlarmHour = hour
    this.newAlarmMinute = minute
    this.newAlarmHourText = pad(hour)
    this.newAlarmMinuteText = pad(minute)
    this.newAlarmRepeat = "once"
    this.showAlarmForm = true
  },

  cancelAlarmForm() {
    this.showAlarmForm = false
  },

  incAlarmHour() {
    this.newAlarmHour = (this.newAlarmHour + 1) % 24
    this.newAlarmHourText = pad(this.newAlarmHour)
  },

  decAlarmHour() {
    this.newAlarmHour = (this.newAlarmHour + 23) % 24
    this.newAlarmHourText = pad(this.newAlarmHour)
  },

  incAlarmMinute() {
    this.newAlarmMinute = (this.newAlarmMinute + 5) % 60
    this.newAlarmMinuteText = pad(this.newAlarmMinute)
  },

  decAlarmMinute() {
    this.newAlarmMinute = (this.newAlarmMinute + 55) % 60
    this.newAlarmMinuteText = pad(this.newAlarmMinute)
  },

  setAlarmRepeat(repeat) {
    this.newAlarmRepeat = repeat
  },

  saveAlarm() {
    const alarm = {
      id: "alarm-" + Date.now(),
      hour: this.newAlarmHour,
      minute: this.newAlarmMinute,
      label:
        pad(this.newAlarmHour) +
        ":" +
        pad(this.newAlarmMinute) +
        (this.newAlarmRepeat === "once" ? "" : this.newAlarmRepeat === "daily" ? " 每天" : " 工作日"),
      repeat: this.newAlarmRepeat,
      enabled: true,
      firedOn: ""
    }
    const added = addAlarm(alarm)
    if (added) {
      this.showAlarmForm = false
    } else {
      this.toast = "闹钟最多 10 个"
      const page = this
      if (this.toastTimer) {
        clearTimeout(this.toastTimer)
      }
      this.toastTimer = setTimeout(function() {
        page.toast = ""
      }, 3000)
    }
  },

  onAlarmToggle(id, event) {
    const checked = event && event.checked !== undefined ? event.checked : true
    setAlarmEnabled(id, checked)
  },

  removeAlarm(id) {
    removeAlarm(id)
  },

  snooze() {
    snoozeAlarm()
  },

  dismiss() {
    dismissAlarm()
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #08110f;
}

.swiper {
  width: 100%;
  height: 100%;
}

.slide {
  width: 100%;
  height: 100%;
  padding: 26px 24px 44px 24px;
  flex-direction: column;
}

.slide-head {
  width: 100%;
  height: 44px;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.back-button {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  background-color: #162521;
  color: #ffffff;
  font-size: 30px;
}

.slide-title {
  flex: 1;
  color: #ffffff;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
}

.head-spacer {
  width: 44px;
  height: 44px;
}

/* —— 圆点指示器 —— */
.dots {
  width: 100%;
  height: 20px;
  bottom: 18px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.dot {
  width: 7px;
  height: 7px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 4px;
  background-color: #2a3a36;
}

.dot-on {
  width: 18px;
  background-color: #64e9b8;
}

/* —— 提示条 —— */
.toast {
  width: 78%;
  top: 18px;
  left: 11%;
  padding: 10px 16px;
  border-radius: 18px;
  background-color: rgba(55, 40, 20, 0.94);
  align-items: center;
  justify-content: center;
}

.toast-text {
  color: #ffd27e;
  font-size: 13px;
  font-weight: bold;
}

/* —— 第 1 页：天气 —— */
.weather-body {
  width: 100%;
  flex: 1;
  margin-top: 4px;
  flex-direction: column;
  align-items: center;
}

.weather-city-row {
  width: 100%;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 6px;
}

.weather-city {
  color: #9fc9c0;
  font-size: 14px;
  font-weight: bold;
}

.cache-badge {
  padding: 3px 8px;
  margin-left: 8px;
  border-radius: 10px;
  background-color: #2a3620;
  color: #b9d28a;
  font-size: 9px;
}

.weather-icon {
  margin-top: 14px;
